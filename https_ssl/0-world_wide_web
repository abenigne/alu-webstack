#!/usr/bin/env bash
# Displays information about the subdomains of a domain

audit_subdomain()
{
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | awk -v name="$2" 'NR == 2 {print "The subdomain " name " is a " $4 " record and points to " $5}'
}

if [ -n "$2" ]; then
    audit_subdomain "$1" "$2"
else
    for subdomain in www lb-01 web-01 web-02; do
        audit_subdomain "$1" "$subdomain"
    done
fi
